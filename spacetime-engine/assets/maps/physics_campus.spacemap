        Ramp(id: "surf/main_right", zone: "surf", start: (1220.0, 900.0, -420.0), yaw_degrees: 180.0, width: 360.0, run: 900.0, rise: -900.0, thickness: 18.0, material: "paint_orange", tags: ["surf", "45deg"]),
        Ramp(id: "surf/transfer_a", zone: "surf", start: (510.0, 64.0, -1250.0), yaw_degrees: 35.0, width: 170.0, run: 520.0, rise: 300.0, thickness: 12.0, material: "steel", tags: ["surf", "transfer"]),
        Ramp(id: "surf/transfer_b", zone: "surf", start: (930.0, 360.0, -800.0), yaw_degrees: -35.0, width: 170.0, run: 520.0, rise: -300.0, thickness: 12.0, material: "steel", tags: ["surf", "transfer"]),
        Box(id: "surf/launch_deck", zone: "surf", position: (720.0, 190.0, -300.0), size: (420.0, 24.0, 260.0), material: "concrete_light", tags: ["launch"]),
        Ramp(id: "surf/launch_ramp", zone: "surf", start: (720.0, 202.0, -420.0), yaw_degrees: 180.0, width: 180.0, run: 220.0, rise: 170.0, thickness: 10.0, material: "hazard", tags: ["launch"]),

