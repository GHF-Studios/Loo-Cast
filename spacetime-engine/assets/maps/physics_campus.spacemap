        Staircase(id: "stairworks/reverse_18u", zone: "stairworks", origin: (1510.0, 0.0, 1112.0), yaw_degrees: 180.0, steps: 16, width: 160.0, step_height: 18.0, step_depth: 32.0, material: "concrete_light", tags: ["stairs", "reverse", "descending", "snap"]),

