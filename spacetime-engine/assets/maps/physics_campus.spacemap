        ConvexPrism(id: "collision/wedge_tall", zone: "collision", position: (-1180.0, 0.0, 1420.0), cross_section: [(-90.0, 0.0), (90.0, 0.0), (90.0, 220.0)], depth: 180.0, material: "paint_blue", tags: ["wedge", "steep"]),
        ConvexPrism(id: "collision/diamond", zone: "collision", position: (-900.0, 90.0, 1420.0), rotation_degrees: (0.0, 20.0, 0.0), cross_section: [(0.0, 90.0), (90.0, 0.0), (0.0, -90.0), (-90.0, 0.0)], depth: 180.0, material: "steel", tags: ["corner", "convex"]),

