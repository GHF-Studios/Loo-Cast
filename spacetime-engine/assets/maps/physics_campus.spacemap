        Sphere(id: "collision/sphere_low", zone: "collision", position: (-1390.0, 48.0, 1890.0), radius: 48.0, material: "paint_green", tags: ["round", "contact"]),
        Sphere(id: "collision/sphere_large", zone: "collision", position: (-1260.0, 96.0, 1890.0), radius: 96.0, material: "concrete_light", tags: ["round", "contact"]),
