        Ramp(id: "slopes/v_right", zone: "slopes", start: (-620.0, 0.0, -860.0), yaw_degrees: 0.0, width: 160.0, run: 320.0, rise: 160.0, thickness: 12.0, material: "steel", tags: ["concave"]),

        // =====================================================================
