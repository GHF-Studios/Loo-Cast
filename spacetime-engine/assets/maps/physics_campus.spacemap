        // =====================================================================
        Box(id: "stairworks/floor", zone: "stairworks", position: (1120.0, -8.0, 640.0), size: (760.0, 16.0, 1400.0), material: "concrete", tags: ["floor"]),
        Staircase(id: "stairworks/classic_18u", zone: "stairworks", origin: (820.0, 0.0, 80.0), steps: 16, width: 160.0, step_height: 18.0, step_depth: 32.0, material: "concrete_light", tags: ["stairs", "source_18u"]),
