#![enable(unwrap_variant_newtypes)]

// Spacetime Physics Campus
// -----------------------------------------------------------------------------
// Distances are authored directly in metres.
//
// Layout rule:
// - Portal Plaza is the orientation/spawn anchor.
// - Immediately adjacent districts contain the tests used most often.
// - Taller, denser and stranger districts live progressively farther outward.
// - Wide transit spines and the perimeter loop remain visually unobstructed.
(
    name: "Spacetime Physics Campus",
    zones: [
        (id: "plaza", name: "Portal Plaza", description: "Clean spawn court, portal pair, landmarks and the campus crossroads."),
        (id: "portal", name: "Portal Lab", description: "Portal-oriented height, exit, fall and velocity experiments directly behind spawn."),
        (id: "calibration", name: "Calibration Yard", description: "Flat exact-distance lanes, jump gaps, clearances and step thresholds."),
        (id: "stairworks", name: "Stairworks", description: "Readable parallel stair families and interrupted support tests."),
        (id: "slopes", name: "Slope Canyon", description: "Walkability thresholds and long slope transitions."),
        (id: "surf", name: "Surf Foundry", description: "Large unmistakable inclined planes and transfer lines."),
        (id: "collision", name: "Collision Zoo", description: "Compact rows of seams, slivers, curved shapes, corners and convex obstacles."),
        (id: "machinery", name: "Machinery Hall", description: "Open steel frame containing kinematic lifts and shuttles."),
        (id: "vertical", name: "Vertical Works", description: "Tall landmark tower, service stairs, decks and fall tests."),
        (id: "habitation", name: "Habitation Block", description: "Two recognisable ordinary buildings for room, door and corridor movement."),
        (id: "transit", name: "Transit Loop", description: "Wide visual circulation spines and an unobstructed perimeter running route."),
        (id: "chaos", name: "Chaos Yard", description: "Deliberately dense mixed geometry isolated at the far south edge."),
    ],

    materials: [
        (id: "concrete", color: (0.28, 0.30, 0.32), metallic: 0.0, roughness: 0.92),
        (id: "concrete_light", color: (0.48, 0.50, 0.52), metallic: 0.0, roughness: 0.88),
        (id: "asphalt", color: (0.07, 0.075, 0.085), metallic: 0.0, roughness: 0.96),
        (id: "steel", color: (0.24, 0.28, 0.32), metallic: 0.72, roughness: 0.36),
        (id: "paint_blue", color: (0.08, 0.28, 0.78), metallic: 0.05, roughness: 0.55),
        (id: "paint_orange", color: (0.95, 0.29, 0.055), metallic: 0.03, roughness: 0.58),
        (id: "paint_yellow", color: (0.92, 0.72, 0.08), metallic: 0.02, roughness: 0.62),
        (id: "paint_green", color: (0.10, 0.62, 0.28), metallic: 0.02, roughness: 0.60),
        (id: "hazard", color: (0.92, 0.13, 0.09), metallic: 0.0, roughness: 0.70),
        (id: "white", color: (0.82, 0.84, 0.86), metallic: 0.0, roughness: 0.80),
        (id: "dark", color: (0.035, 0.04, 0.05), metallic: 0.10, roughness: 0.90),
        (id: "glassish", color: (0.18, 0.52, 0.66), metallic: 0.25, roughness: 0.25),
    ],

    objects: [
        // =====================================================================
        // PORTAL PLAZA -- the map should explain itself from the first frame.
        // =====================================================================
        Box(id: "plaza/floor", zone: "plaza", position: (0.0, -0.20, -1.0), size: (24.0, 0.40, 20.0), material: "concrete_light", tags: ["floor", "hub"]),
        Box(id: "plaza/portal_pad", zone: "plaza", position: (0.0, 0.025, -0.5), size: (12.0, 0.05, 10.0), material: "dark", solid: false, tags: ["visual", "portal"]),

        // Spawn faces north (+Z) into the portal pair, only a few metres away.
        Marker(id: "plaza/player_spawn", zone: "plaza", kind: "player_spawn", position: (0.0, 0.9144, -5.5), rotation_degrees: (0.0, 180.0, 0.0), tags: ["spawn"]),

        // Two orthogonal portal surfaces form an immediately readable L-shaped test court.
        Box(id: "plaza/portal_wall_a", zone: "plaza", position: (-2.8, 2.7, 3.8), size: (5.2, 5.4, 0.40), material: "white", tags: ["portal_surface"]),
        Box(id: "plaza/portal_wall_b", zone: "plaza", position: (4.8, 2.7, -0.5), size: (0.40, 5.4, 6.0), material: "white", tags: ["portal_surface"]),
        Marker(id: "portal/anchor_a", zone: "portal", kind: "portal_a", position: (-2.8, 1.778, 3.55), rotation_degrees: (0.0, 180.0, 0.0), tags: ["portal", "spawn_pair"]),
        Marker(id: "portal/anchor_b", zone: "portal", kind: "portal_b", position: (4.55, 1.778, -0.5), rotation_degrees: (0.0, -90.0, 0.0), tags: ["portal", "spawn_pair"]),

        // Blue/orange beacons make the hub recognisable from almost anywhere.
        Box(id: "plaza/beacon_blue", zone: "plaza", position: (-6.5, 4.0, 4.5), size: (0.55, 8.0, 0.55), material: "paint_blue", tags: ["landmark"]),
        Box(id: "plaza/beacon_orange", zone: "plaza", position: (6.5, 4.0, 4.5), size: (0.55, 8.0, 0.55), material: "paint_orange", tags: ["landmark"]),
        Box(id: "plaza/beacon_bridge", zone: "plaza", position: (0.0, 7.75, 4.5), size: (13.55, 0.50, 0.55), material: "steel", tags: ["landmark"]),

        // Three generous exits. No rails or clutter obscure the cardinal sightlines.
        Box(id: "transit/plaza_west", zone: "transit", position: (-15.5, -0.10, 0.0), size: (7.5, 0.20, 5.0), material: "asphalt", tags: ["route", "connector"]),
        Box(id: "transit/plaza_east", zone: "transit", position: (15.5, -0.10, 0.0), size: (7.5, 0.20, 5.0), material: "asphalt", tags: ["route", "connector"]),
        Box(id: "transit/plaza_south", zone: "transit", position: (0.0, -0.10, -13.0), size: (5.0, 0.20, 7.0), material: "asphalt", tags: ["route", "connector"]),

        // =====================================================================
        // PORTAL LAB -- directly behind the portal court.
        // =====================================================================
        Box(id: "portal/floor", zone: "portal", position: (0.0, -0.20, 14.5), size: (19.0, 0.40, 16.0), material: "white", tags: ["floor"]),
        Box(id: "portal/back_wall", zone: "portal", position: (0.0, 4.5, 22.3), size: (19.0, 9.0, 0.40), material: "concrete_light", tags: ["portal_surface"]),
        Box(id: "portal/left_wall", zone: "portal", position: (-9.3, 4.5, 15.5), size: (0.40, 9.0, 13.6), material: "concrete_light"),
        Box(id: "portal/right_wall", zone: "portal", position: (9.3, 4.5, 15.5), size: (0.40, 9.0, 13.6), material: "concrete_light"),
        Box(id: "portal/mezzanine", zone: "portal", position: (0.0, 5.2, 18.6), size: (11.0, 0.40, 4.8), material: "steel", tags: ["mezzanine"]),
        Ramp(id: "portal/mezzanine_ramp", zone: "portal", start: (-7.0, 0.0, 9.0), yaw_degrees: 0.0, width: 3.2, run: 9.6, rise: 5.2, thickness: 0.30, material: "steel", tags: ["portal", "height"]),
        Staircase(id: "portal/exit_stairs", zone: "portal", origin: (5.5, 0.0, 9.0), yaw_degrees: 0.0, steps: 10, width: 3.2, step_height: 0.4572, step_depth: 0.75, material: "paint_blue", tags: ["portal", "stairs"]),
        Ramp(id: "portal/exit_surf", zone: "portal", start: (5.5, 0.0, 19.5), yaw_degrees: 180.0, width: 3.8, run: 7.5, rise: 7.5, thickness: 0.30, material: "paint_orange", tags: ["portal", "surf"]),
        Box(id: "portal/fall_platform", zone: "portal", position: (-5.8, 10.0, 18.0), size: (4.5, 0.45, 4.5), material: "hazard", tags: ["portal", "fall_loop_candidate"]),

        // =====================================================================
        // CALIBRATION YARD -- immediate west, flat and visually quiet.
        // =====================================================================
        Box(id: "calibration/floor", zone: "calibration", position: (-29.0, -0.20, 0.0), size: (20.0, 0.40, 31.0), material: "asphalt", tags: ["floor"]),
        Box(id: "calibration/backstop", zone: "calibration", position: (-29.0, 2.4, 15.3), size: (20.0, 4.8, 0.40), material: "concrete"),

        // Long speed lane against the west edge, with measured yellow ticks.
        Box(id: "calibration/run_lane", zone: "calibration", position: (-34.0, 0.025, 0.0), size: (3.5, 0.05, 27.5), material: "concrete_light", tags: ["speed", "acceleration"]),
        Box(id: "calibration/tick_0m", zone: "calibration", position: (-34.0, 0.05, -13.0), size: (3.9, 0.10, 0.10), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_3_2512m", zone: "calibration", position: (-34.0, 0.05, -9.7488), size: (3.9, 0.10, 0.10), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_6_5024m", zone: "calibration", position: (-34.0, 0.05, -6.4976), size: (3.9, 0.10, 0.10), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_13_0048m", zone: "calibration", position: (-34.0, 0.05, 0.0048), size: (3.9, 0.10, 0.10), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_19_5072m", zone: "calibration", position: (-34.0, 0.05, 6.5072), size: (3.9, 0.10, 0.10), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_26_0096m", zone: "calibration", position: (-34.0, 0.05, 13.0096), size: (3.9, 0.10, 0.10), material: "paint_yellow", solid: false),

        // Threshold blocks run north-to-south instead of sprawling across adjacent districts.
        StepSweep(
            id: "calibration/step_threshold_0_3556_to_0_5588m",
            zone: "calibration",
            origin: (-28.0, 0.0, 13.0),
            yaw_degrees: 90.0,
            start_height: 0.3556,
            end_height: 0.5588,
            increment: 0.0127,
            width: 1.4224,
            depth: 2.4384,
            gap: 0.254,
            material: "paint_blue",
            tags: ["step", "threshold", "exact"],
        ),

        // Jump lane occupies the east half and reads as one sequence.
        Box(id: "calibration/jump_start", zone: "calibration", position: (-24.0, 0.20, -11.5), size: (3.8, 0.40, 3.8), material: "paint_green", tags: ["jump"]),
        Box(id: "calibration/jump_2_4384m", zone: "calibration", position: (-24.0, 0.20, -5.2616), size: (3.8, 0.40, 3.8), material: "paint_green", tags: ["jump", "gap_2_4384m"]),
        Box(id: "calibration/jump_3_2512m", zone: "calibration", position: (-24.0, 0.20, 1.7896), size: (3.8, 0.40, 3.8), material: "paint_green", tags: ["jump", "gap_3_2512m"]),
        Box(id: "calibration/jump_4_064m", zone: "calibration", position: (-24.0, 0.20, 9.6536), size: (3.8, 0.40, 3.8), material: "paint_green", tags: ["jump", "gap_4_064m"]),

        // Clearance tunnel is isolated along the plaza-facing edge.
        Box(id: "calibration/clearance_left", zone: "calibration", position: (-20.3, 1.63, -4.0), size: (0.40, 3.25, 10.5), material: "concrete"),
        Box(id: "calibration/clearance_right", zone: "calibration", position: (-16.2, 1.63, -4.0), size: (0.40, 3.25, 10.5), material: "concrete"),
        Box(id: "calibration/ceiling_2_032m", zone: "calibration", position: (-18.25, 2.13, -7.8), size: (3.7, 0.20, 1.7), material: "hazard", tags: ["clearance"]),
        Box(id: "calibration/ceiling_1_8796m", zone: "calibration", position: (-18.25, 1.98, -5.9), size: (3.7, 0.20, 1.7), material: "hazard", tags: ["clearance"]),
        Box(id: "calibration/ceiling_1_8288m", zone: "calibration", position: (-18.25, 1.93, -4.0), size: (3.7, 0.20, 1.7), material: "hazard", tags: ["clearance", "standing_height"]),
        Box(id: "calibration/ceiling_1_778m", zone: "calibration", position: (-18.25, 1.88, -2.1), size: (3.7, 0.20, 1.7), material: "hazard", tags: ["clearance"]),
        Box(id: "calibration/ceiling_1_6256m", zone: "calibration", position: (-18.25, 1.73, -0.2), size: (3.7, 0.20, 1.7), material: "hazard", tags: ["clearance"]),

        // =====================================================================
        // STAIRWORKS -- immediate east, strong parallel stepped silhouettes.
        // =====================================================================
        Box(id: "stairworks/floor", zone: "stairworks", position: (29.0, -0.20, 0.0), size: (20.0, 0.40, 31.0), material: "concrete", tags: ["floor"]),
        Staircase(id: "stairworks/classic_0_4572m", zone: "stairworks", origin: (23.0, 0.0, -12.0), steps: 16, width: 3.5, step_height: 0.4572, step_depth: 0.75, material: "concrete_light", tags: ["stairs", "step_0_4572m"]),
        Staircase(id: "stairworks/shallow_0_2032m", zone: "stairworks", origin: (28.5, 0.0, -12.0), steps: 24, width: 3.2, step_height: 0.2032, step_depth: 0.55, material: "paint_green", tags: ["stairs", "shallow"]),
        Staircase(id: "stairworks/tall_0_508m", zone: "stairworks", origin: (34.0, 0.0, -12.0), steps: 12, width: 3.2, step_height: 0.508, step_depth: 0.85, material: "hazard", tags: ["stairs", "over_threshold"]),
        Staircase(id: "stairworks/reverse_0_4572m", zone: "stairworks", origin: (38.0, 0.0, 12.5), yaw_degrees: 180.0, steps: 16, width: 3.5, step_height: 0.4572, step_depth: 0.75, material: "concrete_light", tags: ["stairs", "reverse", "descending", "snap"]),

        // Interrupted support lane sits low near the hub instead of hiding behind the stairs.
        Box(id: "stairworks/island_01", zone: "stairworks", position: (20.5, 0.23, 3.5), size: (2.8, 0.4572, 1.0), material: "paint_blue"),
        Box(id: "stairworks/island_02", zone: "stairworks", position: (20.5, 0.69, 5.0), size: (2.8, 1.3716, 1.0), material: "paint_orange"),
        Box(id: "stairworks/island_03", zone: "stairworks", position: (20.5, 0.91, 6.5), size: (2.8, 1.8288, 1.0), material: "paint_blue"),
        Box(id: "stairworks/island_04", zone: "stairworks", position: (20.5, 1.37, 8.0), size: (2.8, 2.7432, 1.0), material: "paint_orange"),
        Box(id: "stairworks/island_05", zone: "stairworks", position: (20.5, 1.60, 9.5), size: (2.8, 3.2004, 1.0), material: "paint_blue"),

        // =====================================================================
        // SLOPE CANYON -- northwest. Low fan in front, big ramps behind.
        // =====================================================================
        Box(id: "slopes/floor", zone: "slopes", position: (-29.0, -0.20, 34.0), size: (31.0, 0.40, 23.0), material: "concrete", tags: ["floor"]),
        SlopeSweep(
            id: "slopes/walkability_fan",
            zone: "slopes",
            origin: (-43.0, 0.0, 25.0),
            start_angle_degrees: 30.0,
            end_angle_degrees: 60.0,
            angle_increment_degrees: 2.5,
            run: 7.0,
            width: 1.55,
            gap: 0.35,
            thickness: 0.30,
            material: "concrete_light",
            tags: ["slope", "threshold", "walkability"],
        ),
        Ramp(id: "slopes/long_15", zone: "slopes", start: (-40.0, 0.0, 38.0), yaw_degrees: 0.0, width: 4.2, run: 14.0, rise: 3.751289, thickness: 0.30, material: "paint_green", tags: ["slope", "transition"]),
        Ramp(id: "slopes/long_30", zone: "slopes", start: (-34.5, 0.0, 38.0), yaw_degrees: 0.0, width: 4.2, run: 12.0, rise: 6.928203, thickness: 0.30, material: "paint_yellow", tags: ["slope", "transition"]),
        Ramp(id: "slopes/long_45", zone: "slopes", start: (-29.0, 0.0, 38.0), yaw_degrees: 0.0, width: 4.2, run: 9.5, rise: 9.5, thickness: 0.30, material: "paint_orange", tags: ["slope", "steep"]),
        Ramp(id: "slopes/reverse_45", zone: "slopes", start: (-21.5, 9.5, 47.5), yaw_degrees: 180.0, width: 4.2, run: 9.5, rise: -9.5, thickness: 0.30, material: "paint_blue", tags: ["slope", "downhill"]),
        Ramp(id: "slopes/v_left", zone: "slopes", start: (-19.0, 4.0, 27.0), yaw_degrees: 0.0, width: 3.8, run: 8.0, rise: -4.0, thickness: 0.30, material: "steel", tags: ["concave"]),
        Ramp(id: "slopes/v_right", zone: "slopes", start: (-19.0, 0.0, 35.0), yaw_degrees: 0.0, width: 3.8, run: 8.0, rise: 4.0, thickness: 0.30, material: "steel", tags: ["concave"]),

        // =====================================================================
        // SURF FOUNDRY -- northeast. Deliberately huge, simple silhouettes.
        // =====================================================================
        Box(id: "surf/floor", zone: "surf", position: (29.0, -0.60, 34.0), size: (32.0, 1.20, 23.0), material: "dark", tags: ["floor"]),
        Box(id: "surf/west_wall", zone: "surf", position: (13.2, 5.0, 34.0), size: (0.50, 10.0, 23.0), material: "steel"),
        Box(id: "surf/east_wall", zone: "surf", position: (44.8, 5.0, 34.0), size: (0.50, 10.0, 23.0), material: "steel"),
        Ramp(id: "surf/main_left", zone: "surf", start: (19.0, 0.0, 24.5), yaw_degrees: 0.0, width: 8.0, run: 19.0, rise: 19.0, thickness: 0.45, material: "paint_blue", tags: ["surf", "45deg"]),
        Ramp(id: "surf/main_right", zone: "surf", start: (39.0, 19.0, 43.5), yaw_degrees: 180.0, width: 8.0, run: 19.0, rise: -19.0, thickness: 0.45, material: "paint_orange", tags: ["surf", "45deg"]),
        Ramp(id: "surf/transfer_a", zone: "surf", start: (25.0, 1.5, 26.0), yaw_degrees: 35.0, width: 3.8, run: 11.0, rise: 6.2, thickness: 0.30, material: "steel", tags: ["surf", "transfer"]),
        Ramp(id: "surf/transfer_b", zone: "surf", start: (34.0, 7.7, 35.5), yaw_degrees: -35.0, width: 3.8, run: 11.0, rise: -6.2, thickness: 0.30, material: "steel", tags: ["surf", "transfer"]),
        Box(id: "surf/launch_deck", zone: "surf", position: (29.0, 4.5, 45.0), size: (9.0, 0.50, 4.0), material: "concrete_light", tags: ["launch"]),
        Ramp(id: "surf/launch_ramp", zone: "surf", start: (29.0, 4.75, 43.0), yaw_degrees: 180.0, width: 4.0, run: 5.0, rise: 4.0, thickness: 0.25, material: "hazard", tags: ["launch"]),

        // =====================================================================
        // COLLISION ZOO -- far northwest, compact rows instead of scatter.
        // =====================================================================
        Box(id: "collision/floor", zone: "collision", position: (-29.0, -0.20, 65.0), size: (25.0, 0.40, 22.0), material: "concrete", tags: ["floor"]),

        // Curved/contact row.
        Sphere(id: "collision/sphere_low", zone: "collision", position: (-39.0, 1.2, 70.0), radius: 1.2, material: "paint_green", tags: ["round", "contact"]),
        Sphere(id: "collision/sphere_large", zone: "collision", position: (-35.5, 2.3, 70.0), radius: 2.3, material: "concrete_light", tags: ["round", "contact"]),
        Capsule(id: "collision/capsule_upright", zone: "collision", position: (-31.5, 2.1, 70.0), radius: 0.9, length: 2.5, material: "paint_yellow", tags: ["round", "contact"]),
        Capsule(id: "collision/capsule_tilted", zone: "collision", position: (-27.5, 2.0, 70.0), rotation_degrees: (0.0, 0.0, 55.0), radius: 0.8, length: 3.0, material: "paint_orange", tags: ["round", "tilted"]),
        Cylinder(id: "collision/cylinder", zone: "collision", position: (-23.0, 2.0, 70.0), radius: 1.5, height: 4.0, material: "paint_blue", tags: ["round", "vertical"]),

        // Convex row.
        ConvexPrism(id: "collision/wedge_acute", zone: "collision", position: (-39.0, 0.0, 60.0), cross_section: [(-2.2, 0.0), (2.2, 0.0), (2.2, 0.30)], depth: 4.0, material: "paint_orange", tags: ["wedge", "acute"]),
        ConvexPrism(id: "collision/wedge_tall", zone: "collision", position: (-33.0, 0.0, 60.0), cross_section: [(-2.2, 0.0), (2.2, 0.0), (2.2, 5.4)], depth: 4.0, material: "paint_blue", tags: ["wedge", "steep"]),
        ConvexPrism(id: "collision/diamond", zone: "collision", position: (-26.0, 2.2, 60.0), rotation_degrees: (0.0, 20.0, 0.0), cross_section: [(0.0, 2.2), (2.2, 0.0), (0.0, -2.2), (-2.2, 0.0)], depth: 4.0, material: "steel", tags: ["corner", "convex"]),

        // Micro-contact/seam bench.
        Box(id: "collision/ledge_0_0254m", zone: "collision", position: (-40.0, 0.0127, 65.0), size: (4.5, 0.0254, 0.55), material: "hazard", tags: ["thin", "ledge"]),
        Box(id: "collision/ledge_0_0508m", zone: "collision", position: (-40.0, 0.0254, 66.2), size: (4.5, 0.0508, 0.55), material: "hazard", tags: ["thin", "ledge"]),
        Box(id: "collision/ledge_0_1016m", zone: "collision", position: (-40.0, 0.0508, 67.4), size: (4.5, 0.1016, 0.55), material: "hazard", tags: ["thin", "ledge"]),
        Box(id: "collision/seam_left", zone: "collision", position: (-32.1, 0.80, 65.0), size: (5.95, 1.60, 4.8), material: "concrete_light", tags: ["seam"]),
        Box(id: "collision/seam_right", zone: "collision", position: (-26.05, 0.80, 65.0), size: (5.95, 1.60, 4.8), material: "concrete_light", tags: ["seam"]),

        // Corner/slot course at the far edge.
        Box(id: "collision/corner_wall_a", zone: "collision", position: (-38.0, 2.4, 75.2), size: (7.0, 4.8, 0.55), material: "dark", tags: ["inside_corner"]),
        Box(id: "collision/corner_wall_b", zone: "collision", position: (-34.75, 2.4, 72.0), size: (0.55, 4.8, 7.0), material: "dark", tags: ["inside_corner"]),
        Box(id: "collision/slot_wall_a", zone: "collision", position: (-28.0, 2.4, 75.0), size: (0.55, 4.8, 6.0), material: "steel", tags: ["slot"]),
        Box(id: "collision/slot_wall_b", zone: "collision", position: (-27.0, 2.4, 75.0), size: (0.55, 4.8, 6.0), material: "steel", tags: ["slot", "narrow"]),
