#![enable(unwrap_variant_newtypes)]

// Physics Campus
// -----------------------------------------------------------------------------
// Distances are authored in Source-style inches. The runtime converts them to
// Bevy metres using unit_scale. This file is intentionally content, not code:
// save it while the game is running and Bevy's file watcher rebuilds the map.
(
    name: "Spacetime Physics Campus",
    unit_scale: 0.0254,

    zones: [
        (id: "plaza", name: "Central Plaza", description: "Spawn hub and route interchange."),
        (id: "calibration", name: "Calibration Yard", description: "Exact movement dimensions, jump distances and clearance checks."),
        (id: "stairworks", name: "Stairworks", description: "Conventional, threshold and pathological stairs."),
        (id: "slopes", name: "Slope Canyon", description: "Walkability thresholds, transitions and ramp geometry."),
        (id: "surf", name: "Surf Foundry", description: "Large inclined planes, transfers, channels and speed retention."),
        (id: "collision", name: "Collision Zoo", description: "Seams, acute prisms, slivers, corners and obstacle fields."),
        (id: "machinery", name: "Machinery Hall", description: "Kinematic platforms, lifts and timing obstacles."),
        (id: "vertical", name: "Vertical Works", description: "Shafts, landings, stacked floors and overhead constraints."),
        (id: "habitation", name: "Habitation Block", description: "Ordinary rooms, doors, roofs and believable navigation."),
        (id: "portal", name: "Portal Research Wing", description: "Impossible routes and velocity/orientation experiments."),
        (id: "transit", name: "Transit Loop", description: "Long uninterrupted running routes around the campus."),
        (id: "chaos", name: "Chaos Yard", description: "Dense mixed geometry for unscripted abuse."),
    ],

    materials: [
        (id: "concrete", color: (0.28, 0.30, 0.32), metallic: 0.0, roughness: 0.92),
        (id: "concrete_light", color: (0.48, 0.50, 0.52), metallic: 0.0, roughness: 0.88),
        (id: "asphalt", color: (0.07, 0.075, 0.085), metallic: 0.0, roughness: 0.96),
        (id: "steel", color: (0.24, 0.28, 0.32), metallic: 0.72, roughness: 0.36),
        (id: "paint_blue", color: (0.08, 0.28, 0.78), metallic: 0.05, roughness: 0.55),
        (id: "paint_orange", color: (0.95, 0.29, 0.055), metallic: 0.03, roughness: 0.58),
        (id: "paint_yellow", color: (0.92, 0.72, 0.08), metallic: 0.02, roughness: 0.62),
        (id: "paint_green", color: (0.10, 0.62, 0.28), metallic: 0.02, roughness: 0.60),
        (id: "hazard", color: (0.92, 0.13, 0.09), metallic: 0.0, roughness: 0.7),
        (id: "white", color: (0.82, 0.84, 0.86), metallic: 0.0, roughness: 0.8),
        (id: "dark", color: (0.035, 0.04, 0.05), metallic: 0.1, roughness: 0.9),
        (id: "glassish", color: (0.18, 0.52, 0.66), metallic: 0.25, roughness: 0.25),
    ],

    objects: [
        // =====================================================================
        // CENTRAL PLAZA / SPAWN HUB
        // =====================================================================
        Box(id: "plaza/floor", zone: "plaza", position: (0.0, -8.0, 256.0), size: (1400.0, 16.0, 1050.0), material: "concrete", tags: ["floor", "hub"]),
        Box(id: "plaza/south_wall_left", zone: "plaza", position: (-410.0, 64.0, -264.0), size: (580.0, 128.0, 16.0), material: "concrete_light"),
        Box(id: "plaza/south_wall_right", zone: "plaza", position: (410.0, 64.0, -264.0), size: (580.0, 128.0, 16.0), material: "concrete_light"),
        Box(id: "plaza/east_rail", zone: "plaza", position: (690.0, 24.0, 300.0), size: (20.0, 48.0, 900.0), material: "steel"),
        Box(id: "plaza/west_rail", zone: "plaza", position: (-690.0, 24.0, 300.0), size: (20.0, 48.0, 900.0), material: "steel"),
        Cylinder(id: "plaza/monument", zone: "plaza", position: (0.0, 96.0, 80.0), radius: 48.0, height: 192.0, material: "steel", tags: ["landmark"]),
        Box(id: "plaza/monument_cap", zone: "plaza", position: (0.0, 202.0, 80.0), size: (120.0, 20.0, 120.0), rotation_degrees: (0.0, 45.0, 0.0), material: "paint_orange"),
        Marker(id: "plaza/player_spawn", zone: "plaza", kind: "player_spawn", position: (0.0, 36.0, 315.0), rotation_degrees: (0.0, 180.0, 0.0), tags: ["spawn"]),

        // Plaza route ramps make every district reachable without teleportation.
        Ramp(id: "plaza/ramp_to_calibration", zone: "plaza", start: (-560.0, 0.0, 640.0), yaw_degrees: -90.0, width: 180.0, run: 320.0, rise: 0.0, thickness: 12.0, material: "concrete_light"),
        Ramp(id: "plaza/ramp_to_stairworks", zone: "plaza", start: (560.0, 0.0, 640.0), yaw_degrees: 90.0, width: 180.0, run: 320.0, rise: 0.0, thickness: 12.0, material: "concrete_light"),
        Box(id: "plaza/north_avenue", zone: "plaza", position: (0.0, -4.0, 990.0), size: (240.0, 8.0, 440.0), material: "asphalt", tags: ["route", "connector"]),
        Box(id: "plaza/south_gate_bridge", zone: "plaza", position: (0.0, -4.0, -315.0), size: (240.0, 8.0, 120.0), material: "asphalt", tags: ["route", "connector"]),

        // =====================================================================
        // CALIBRATION YARD
        // =====================================================================
        Box(id: "calibration/floor", zone: "calibration", position: (-1120.0, -8.0, 640.0), size: (760.0, 16.0, 1400.0), material: "asphalt", tags: ["floor"]),
        Box(id: "calibration/backstop", zone: "calibration", position: (-1120.0, 96.0, 1332.0), size: (760.0, 192.0, 16.0), material: "concrete"),

        // Long acceleration lane with precise distance ticks.
        Box(id: "calibration/run_lane", zone: "calibration", position: (-1300.0, 1.0, 630.0), size: (160.0, 2.0, 1100.0), material: "concrete_light", tags: ["speed", "acceleration"]),
        Box(id: "calibration/tick_0", zone: "calibration", position: (-1300.0, 2.0, 120.0), size: (176.0, 4.0, 4.0), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_128", zone: "calibration", position: (-1300.0, 2.0, 248.0), size: (176.0, 4.0, 4.0), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_256", zone: "calibration", position: (-1300.0, 2.0, 376.0), size: (176.0, 4.0, 4.0), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_512", zone: "calibration", position: (-1300.0, 2.0, 632.0), size: (176.0, 4.0, 4.0), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_768", zone: "calibration", position: (-1300.0, 2.0, 888.0), size: (176.0, 4.0, 4.0), material: "paint_yellow", solid: false),
        Box(id: "calibration/tick_1024", zone: "calibration", position: (-1300.0, 2.0, 1144.0), size: (176.0, 4.0, 4.0), material: "paint_yellow", solid: false),

        // Exact step threshold sweep. With the Source profile's 18u step this straddles
        // the intended automatic-step boundary in half-unit increments.
        StepSweep(
            id: "calibration/step_threshold_14_to_22",
            zone: "calibration",
            origin: (-1536.0, 0.0, 60.0),
            start_height: 14.0,
            end_height: 22.0,
            increment: 0.5,
            width: 56.0,
            depth: 96.0,
            gap: 10.0,
            material: "paint_blue",
            tags: ["step", "threshold", "exact"],
        ),

        // Jump islands at increasingly obnoxious gaps.
        Box(id: "calibration/jump_start", zone: "calibration", position: (-980.0, 8.0, 220.0), size: (160.0, 16.0, 160.0), material: "paint_green", tags: ["jump"]),
        Box(id: "calibration/jump_96", zone: "calibration", position: (-980.0, 8.0, 476.0), size: (160.0, 16.0, 160.0), material: "paint_green", tags: ["jump", "gap_96"]),
        Box(id: "calibration/jump_128", zone: "calibration", position: (-980.0, 8.0, 764.0), size: (160.0, 16.0, 160.0), material: "paint_green", tags: ["jump", "gap_128"]),
        Box(id: "calibration/jump_160", zone: "calibration", position: (-980.0, 8.0, 1084.0), size: (160.0, 16.0, 160.0), material: "paint_green", tags: ["jump", "gap_160"]),

        // Ceiling/clearance corridor: floor remains constant while ceilings descend.
        Box(id: "calibration/clearance_left", zone: "calibration", position: (-780.0, 64.0, 450.0), size: (16.0, 128.0, 650.0), material: "concrete"),
        Box(id: "calibration/clearance_right", zone: "calibration", position: (-580.0, 64.0, 450.0), size: (16.0, 128.0, 650.0), material: "concrete"),
        Box(id: "calibration/ceiling_80", zone: "calibration", position: (-680.0, 84.0, 210.0), size: (184.0, 8.0, 100.0), material: "hazard", tags: ["clearance"]),
        Box(id: "calibration/ceiling_74", zone: "calibration", position: (-680.0, 78.0, 330.0), size: (184.0, 8.0, 100.0), material: "hazard", tags: ["clearance"]),
        Box(id: "calibration/ceiling_72", zone: "calibration", position: (-680.0, 76.0, 450.0), size: (184.0, 8.0, 100.0), material: "hazard", tags: ["clearance", "standing_height"]),
        Box(id: "calibration/ceiling_70", zone: "calibration", position: (-680.0, 74.0, 570.0), size: (184.0, 8.0, 100.0), material: "hazard", tags: ["clearance"]),
        Box(id: "calibration/ceiling_64", zone: "calibration", position: (-680.0, 68.0, 690.0), size: (184.0, 8.0, 100.0), material: "hazard", tags: ["clearance"]),

        // =====================================================================
