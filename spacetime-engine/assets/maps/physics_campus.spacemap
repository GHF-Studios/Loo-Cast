        Ramp(id: "slopes/long_30", zone: "slopes", start: (-1080.0, 0.0, -620.0), yaw_degrees: 0.0, width: 180.0, run: 560.0, rise: 323.32, thickness: 12.0, material: "paint_yellow", tags: ["slope", "transition"]),
        Ramp(id: "slopes/long_45", zone: "slopes", start: (-840.0, 0.0, -620.0), yaw_degrees: 0.0, width: 180.0, run: 420.0, rise: 420.0, thickness: 12.0, material: "paint_orange", tags: ["slope", "steep"]),
        Ramp(id: "slopes/reverse_45", zone: "slopes", start: (-520.0, 420.0, -200.0), yaw_degrees: 180.0, width: 180.0, run: 420.0, rise: -420.0, thickness: 12.0, material: "paint_blue", tags: ["slope", "downhill"]),

