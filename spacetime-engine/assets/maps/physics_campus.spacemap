        Box(id: "stairworks/island_02", zone: "stairworks", position: (870.0, 27.0, 960.0), size: (120.0, 54.0, 40.0), material: "paint_orange"),
        Box(id: "stairworks/island_03", zone: "stairworks", position: (870.0, 36.0, 1020.0), size: (120.0, 72.0, 40.0), material: "paint_blue"),
        Box(id: "stairworks/island_04", zone: "stairworks", position: (870.0, 54.0, 1080.0), size: (120.0, 108.0, 40.0), material: "paint_orange"),
        Box(id: "stairworks/island_05", zone: "stairworks", position: (870.0, 63.0, 1140.0), size: (120.0, 126.0, 40.0), material: "paint_blue"),

